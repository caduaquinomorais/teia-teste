# TEIA — regras da pasta pública (Apache).
# Atenção (KingHost): não use php_value/php_flag aqui — causa erro 500 no PHP-FPM.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Arquivos e pastas ocultos (.git, .env, .htaccess…) nunca são servidos.
    RewriteRule (^|/)\. - [R=404,L]

    # Força HTTPS (descomente após ativar o certificado SSL no painel da KingHost).
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Tudo que não for arquivo existente vai para o front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    <FilesMatch "\.(css|js|woff2|webp|jpg|jpeg|png|svg)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
